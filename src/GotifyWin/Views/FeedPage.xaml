<UserControl x:Class="GotifyWin.Views.FeedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GotifyWin.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource ThemeBackground}">
    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Modern Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryButtonText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter & Search Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeCardBackground}" CornerRadius="6"
                    BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Padding="8,4" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextMuted}"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13"
                             VerticalAlignment="Center" CaretBrush="{DynamicResource ThemeTextPrimary}"/>
                </Grid>
            </Border>

            <!-- App Filter Dropdown -->
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableAppFilters}" SelectedItem="{Binding SelectedAppFilter}"
                      Width="160" Height="34" Margin="0,0,12,0"/>

            <!-- Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="🔔 Test Alert" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding TestNotificationCommand}"/>
                <Button Content="Clear All" Style="{StaticResource SecondaryButton}" Command="{Binding ClearAllCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Empty State -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="🔔" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.5"/>
            <TextBlock Text="All caught up!" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center"/>
            <TextBlock Text="No notifications in your feed right now." FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Messages Feed List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                      Visibility="{Binding HasMessages, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding FilteredMessages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Accent Color Stripe -->
                                <Border Grid.Column="0" Background="{Binding PriorityColor, Converter={StaticResource HexToBrush}}"/>

                                <Grid Grid.Column="1" Margin="14,12,14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column: Message Content -->
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Meta Bar: App Name, Time, Priority Badge -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayAppName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeBrandAccent}"/>
                                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource ThemeTextMuted}"/>
                                                <TextBlock Text="{Binding RelativeTime}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                <TextBlock Text="{Binding FormattedDate, StringFormat=' ({0})'}" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <!-- Filtered by Rule Badge -->
                                                <Border CornerRadius="3" Background="#1E3A5F" BorderBrush="#3B82F6" BorderThickness="1" Padding="5,1" Margin="0,0,6,0"
                                                        Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="{Binding FilteredByRuleName, StringFormat='Automatically filtered: {0}'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔕 " FontSize="9" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FilteredByRuleName, StringFormat='Filtered: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Debounce duplicate badge -->
                                                <Border CornerRadius="3" Background="{DynamicResource ThemeCardInnerBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Padding="5,1" Margin="0,0,6,0"
                                                        Visibility="{Binding DuplicateCount, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DuplicateCount, StringFormat='x{0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                </Border>

                                                <!-- Priority Badge -->
                                                <Border CornerRadius="4" Background="{Binding PriorityColor, Converter={StaticResource HexToBrush}}" Padding="7,2"
                                                        ToolTip="{Binding PriorityTooltip}">
                                                    <TextBlock Text="{Binding PriorityDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding PriorityTextColor, Converter={StaticResource HexToBrush}}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Title -->
                                        <TextBlock Grid.Row="1" Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                        <!-- Body -->
                                        <TextBlock Grid.Row="2" Text="{Binding Message}" FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,8"/>

                                        <!-- Action Bar -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="🖼 View Image" Style="{StaticResource CardActionButton}" Margin="0,0,6,0"
                                                    Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding ImageUrl}"/>
                                            <Button Content="🔗 Open Link" Style="{StaticResource CardActionButton}" Margin="0,0,6,0"
                                                    Visibility="{Binding HasClickUrl, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding ClickUrl}"/>
                                            <Button Content="⚡ Create Rule" Style="{StaticResource CardActionButton}" Margin="0,0,6,0"
                                                    ToolTip="Pre-fill a new filter rule using this notification"
                                                    Command="{Binding DataContext.CreateRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="📋 Copy" Style="{StaticResource CardActionButton}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="✕ Dismiss" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Right Column: Attached Image Thumbnail -->
                                    <Button Grid.Column="1" VerticalAlignment="Top" Margin="14,0,0,0"
                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding ImageUrl}"
                                            ToolTip="Click to open full image"
                                            Cursor="Hand"
                                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"
                                            Background="Transparent" BorderThickness="0" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="110" Height="82" CornerRadius="8"
                                                        Background="{DynamicResource ThemeCardInnerBackground}"
                                                        BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border Background="#55000000" VerticalAlignment="Bottom" Padding="4,2">
                                                            <TextBlock Text="🔍 View" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
