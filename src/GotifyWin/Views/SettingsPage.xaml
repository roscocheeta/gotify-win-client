<UserControl x:Class="GotifyWin.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cfg="clr-namespace:GotifyWin.Models.Config"
             xmlns:conv="clr-namespace:GotifyWin.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="950" d:DesignWidth="800"
             Background="{DynamicResource ThemeBackground}">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryButton}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemePrimaryButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryButtonText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="24,16,24,24"
                  Padding="0,0,14,0"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
        <StackPanel>
            <!-- Page Header -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                <TextBlock Text="Configure server connection, alert popups, quiet hours, and app preferences."
                           FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- 1. Server Connection -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Gotify Server Connection" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,12"/>

                    <TextBlock Text="Server URL (e.g. https://gotify.homelab.lan:8080)" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="Client Token" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                    
                    <!-- Masked Token Input Grid with Eye Reveal & Copy Buttons -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Unmasked editable text box -->
                        <TextBox Grid.Column="0" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding ClientToken, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsTokenRevealed, Converter={StaticResource BoolToVis}}"
                                 Margin="0,0,8,0"/>

                        <!-- Masked bullet text box -->
                        <TextBox Grid.Column="0" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding MaskedDisplayToken, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Visibility="{Binding IsTokenRevealed, Converter={StaticResource InverseBoolToVis}}"
                                 Margin="0,0,8,0"/>

                        <!-- Eye Reveal Button -->
                        <Button Grid.Column="1" Content="{Binding TokenEyeIcon}" Style="{StaticResource SecondaryButton}"
                                ToolTip="{Binding TokenEyeTooltip}" Width="38" Padding="0" Margin="0,0,6,0"
                                Command="{Binding ToggleTokenVisibilityCommand}"/>

                        <!-- Copy Button -->
                        <Button Grid.Column="2" Content="📋" Style="{StaticResource SecondaryButton}"
                                ToolTip="Copy token to clipboard" Width="38" Padding="0"
                                Command="{Binding CopyTokenCommand}"/>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Test Connection" Style="{StaticResource SecondaryButton}" Command="{Binding TestConnectionCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Save Connection" Style="{StaticResource PrimaryButton}" Command="{Binding SaveConnectionCommand}"/>
                        <TextBlock Grid.Column="2" Text="{Binding TestStatus}" FontSize="12" Foreground="{DynamicResource ThemeBrandAccent}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Windows 11 Notification Presentation -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Alerts &amp; Popups" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        <Button Content="🔔 Preview Alert" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding SendTestNotificationCommand}"/>
                    </Grid>

                    <!-- Presentation Mode -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Popup Style" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="Choose how incoming alerts appear on your desktop." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Height="34"
                                  SelectedValue="{Binding SelectedMode}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Minimal Floating Banner (Recommended)" Tag="{x:Static cfg:NotificationMode.CustomHud}"/>
                            <ComboBoxItem Content="Windows Notification Center (Standard)" Tag="{x:Static cfg:NotificationMode.NativeToast}"/>
                            <ComboBoxItem Content="Both (Floating Banner + Windows)" Tag="{x:Static cfg:NotificationMode.Both}"/>
                        </ComboBox>
                    </Grid>

                    <!-- HUD Screen Position -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Banner Position" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="Screen location where floating banners appear." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Height="34"
                                  SelectedValue="{Binding SelectedPosition}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Bottom-Right (Standard)" Tag="{x:Static cfg:HudPosition.BottomRight}"/>
                            <ComboBoxItem Content="Top-Right" Tag="{x:Static cfg:HudPosition.TopRight}"/>
                            <ComboBoxItem Content="Top-Center" Tag="{x:Static cfg:HudPosition.TopCenter}"/>
                            <ComboBoxItem Content="Bottom-Center" Tag="{x:Static cfg:HudPosition.BottomCenter}"/>
                        </ComboBox>
                    </Grid>

                    <!-- Display Duration -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Banner Duration" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="How long floating banners stay visible before auto-dismissing." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Minimum="2" Maximum="20" Value="{Binding DisplayDurationSeconds}" Width="160" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding DisplayDurationText}" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Countdown Bar Toggle -->
                    <CheckBox Content="Show countdown progress bar on floating banners"
                              IsChecked="{Binding ShowCountdownBar}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Margin="0,0,0,14"/>

                    <!-- Sound Toggle -->
                    <CheckBox Content="Play notification chime"
                              IsChecked="{Binding PlaySound}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Margin="0,0,0,14"/>

                    <!-- Smart Fullscreen Gaming & Presentation Suppression -->
                    <CheckBox Content="Mute alert popups while gaming, watching fullscreen video, or presenting"
                              IsChecked="{Binding SuppressOnFullscreen}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Margin="0,0,0,4"/>
                </StackPanel>
            </Border>

            <!-- 3. Global Priority & Debounce Anti-Spam -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Filtering &amp; Anti-Spam Debounce" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,12"/>

                    <!-- Card A: Global Minimum Priority -->
                    <Border Background="{DynamicResource ThemeCardInnerBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Global Minimum Priority" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock Text="Silently log messages with a priority lower than this threshold directly into history without triggering a popup or chime."
                                               FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource ThemePrimaryButton}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GlobalMinPriorityText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                            <Slider Minimum="0" Maximum="10" Value="{Binding GlobalMinPriority}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card B: Anti-Flap Debounce -->
                    <Border Background="{DynamicResource ThemeCardInnerBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="0,0,0,4">
                        <StackPanel>
                            <CheckBox Content="Enable anti-flap debounce (combines duplicate rapid alerts into one)"
                                      IsChecked="{Binding EnableDebounce}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Prevents notification storms by combining identical consecutive alerts from the same app within a short window."
                                       FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="24,0,0,0"/>

                            <!-- Debounce Window Slider -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding EnableDebounce, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Debounce Window Duration" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <Border Grid.Column="1" Background="#475569" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DebounceText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <Slider Minimum="3" Maximum="60" Value="{Binding DebounceWindowSeconds}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. Do Not Disturb & Quiet Hours -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Do Not Disturb &amp; Quiet Hours" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,12"/>

                    <!-- Emergency Breakthrough -->
                    <CheckBox Content="Allow critical emergencies to break through active DND"
                              IsChecked="{Binding EnableEmergencyBypass}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Margin="0,0,0,8"/>

                    <Border Background="{DynamicResource ThemeCardInnerBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="0,4,0,14"
                            Visibility="{Binding EnableEmergencyBypass, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Breakthrough Priority Threshold" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock Text="Alerts with this priority or higher will bypass DND and sound immediately." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#DC2626" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EmergencyBypassPriorityText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                            <Slider Minimum="5" Maximum="10" Value="{Binding EmergencyBypassPriority}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Scheduled Quiet Hours -->
                    <CheckBox Content="Enable scheduled quiet hours (e.g. sleep/work focus)"
                              IsChecked="{Binding EnableQuietHours}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,4" Visibility="{Binding EnableQuietHours, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Start:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBox}" Text="{Binding QuietHoursStart}" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="End:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3" Style="{StaticResource SettingsTextBox}" Text="{Binding QuietHoursEnd}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Appearance & System Preferences -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; System Integration" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,12"/>

                    <!-- Theme Mode Selector -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="App Theme Mode" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="Choose Dark, Light, or follow your Windows 11 system mode." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Height="34"
                                  SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Windows Default (Auto)" Tag="{x:Static cfg:AppThemeMode.System}"/>
                            <ComboBoxItem Content="Dark Mode" Tag="{x:Static cfg:AppThemeMode.Dark}"/>
                            <ComboBoxItem Content="Light Mode" Tag="{x:Static cfg:AppThemeMode.Light}"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox Content="Start Gotify Client automatically with Windows" IsChecked="{Binding StartWithWindows}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Margin="0,0,0,8"/>
                    <CheckBox Content="Minimize to System Tray when closing the window" IsChecked="{Binding MinimizeToTrayOnClose}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- 6. Backup & Migration -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Backup &amp; Restore" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="Export full settings (including app priority filters, quiet hours, and display preferences) or restore from a backup file."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📤 Export Settings" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding ExportSettingsCommand}"/>
                            <Button Content="📥 Import Settings" Style="{StaticResource SecondaryButton}" Command="{Binding ImportSettingsCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding BackupStatusText}" FontSize="11" Foreground="{DynamicResource ThemeBrandAccent}"
                               Visibility="{Binding HasBackupStatus, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
