<UserControl x:Class="GotifyWin.Views.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cfg="clr-namespace:GotifyWin.Models.Config"
             xmlns:conv="clr-namespace:GotifyWin.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="850"
             Background="{DynamicResource ThemeBackground}">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryButton}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemePrimaryButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SilentLogButton" TargetType="Button">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DropButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryButtonText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryButtonText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Filter Rules &amp; Noise Reduction" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                <TextBlock Text="Automated recommendations and custom rules to keep your desktop noise-free."
                           FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="{Binding ReanalyzeButtonText}" Style="{StaticResource SecondaryButton}"
                    Width="145" HorizontalContentAlignment="Center"
                    Command="{Binding ReanalyzeCommand}" ToolTip="Scan message history for repetitive patterns (minimum 3 occurrences)"/>
        </Grid>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>

                <!-- ========================================== -->
                <!-- 1. SMART RECOMMENDATIONS SECTION           -->
                <!-- ========================================== -->
                <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Cursor="Hand">
                            <Grid.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleRecommendationsCommand}"/>
                            </Grid.InputBindings>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💡 Smart Noise Recommendations" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <Border CornerRadius="10" Background="{DynamicResource ThemePrimaryButton}" Padding="8,2" Margin="10,0,0,0"
                                        Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding RecommendationsSummaryText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" Padding="10,5" Command="{Binding ToggleRecommendationsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Content" Value="Expand ▼"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecommendationsExpanded}" Value="True">
                                                <Setter Property="Content" Value="Collapse ▲"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Collapsible Content -->
                        <StackPanel Visibility="{Binding IsRecommendationsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">

                        <!-- Empty State: No recommendations detected -->
                        <Border Background="{DynamicResource ThemeCardInnerBackground}" CornerRadius="6" Padding="14,12" Margin="0,0,0,4"
                                Visibility="{Binding HasRecommendations, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="All clean! No repetitive noise patterns detected yet (minimum 3 occurrences required)."
                                           FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Recommendations List -->
                        <ItemsControl ItemsSource="{Binding Recommendations}"
                                      Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeCardInnerBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="14,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Main Card Row -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Title, Description, Pattern -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding AppName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeBrandAccent}"/>
                                                        <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource ThemeTextMuted}"/>
                                                        <Border CornerRadius="3" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding MatchCount, StringFormat='Seen {0} times'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,6"/>

                                                    <!-- Preview Toggle Button -->
                                                    <Button Content="{Binding PreviewToggleText}" Style="{StaticResource SecondaryButton}"
                                                            Padding="8,3" FontSize="10" HorizontalAlignment="Left"
                                                            Command="{Binding TogglePreviewCommand}"/>
                                                </StackPanel>

                                                <!-- Right: Action Buttons -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="🔕 Silent Log" Style="{StaticResource SilentLogButton}" Margin="0,0,8,0"
                                                            ToolTip="Record in history but suppress popup &amp; chime"
                                                            Command="{Binding ApplySilentLogCommand}"/>
                                                    <Button Content="🔇 Drop" Style="{StaticResource DropButton}" Margin="0,0,8,0"
                                                            ToolTip="Completely discard matching notifications"
                                                            Command="{Binding ApplyDropCommand}"/>
                                                    <Button Content="✕" Width="26" Height="26" Background="Transparent" BorderThickness="0"
                                                            Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" Cursor="Hand" ToolTip="Dismiss recommendation"
                                                            Command="{Binding DismissCommand}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Expandable Match Preview Drawer -->
                                            <Border Grid.Row="1" Background="{DynamicResource ThemeBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                    CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                                    Visibility="{Binding IsPreviewExpanded, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="Sample Matching Historical Messages:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                    <ItemsControl ItemsSource="{Binding SampleMessages}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="0,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding FormattedDate}" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,6,0"/>
                                                                            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========================================== -->
                <!-- 2. CONFIGURED RULES SECTION                -->
                <!-- ========================================== -->
                <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand">
                                <StackPanel.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleConfiguredRulesCommand}"/>
                                </StackPanel.InputBindings>
                                <TextBlock Text="🛡️ Configured Rules" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <Border CornerRadius="10" Background="{DynamicResource ThemeCardInnerBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Padding="7,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding RulesSummaryText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📤 Export" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                        Command="{Binding ExportRulesCommand}" ToolTip="Export configured rules to a JSON file"/>
                                <Button Content="📥 Import" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,10,0"
                                        Command="{Binding ImportRulesCommand}" ToolTip="Import rules from a JSON file with preview &amp; selection"/>
                                <Button Padding="10,5" Command="{Binding ToggleConfiguredRulesCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Content" Value="Expand ▼"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfiguredRulesExpanded}" Value="True">
                                                    <Setter Property="Content" Value="Collapse ▲"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Collapsible Content -->
                        <StackPanel Visibility="{Binding IsConfiguredRulesExpanded, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                            <!-- Rule Status Feedback (Transient Banner) -->
                            <Border Background="{DynamicResource ThemeCardInnerBackground}" BorderBrush="{DynamicResource ThemeBrandAccent}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,0,10"
                                    Visibility="{Binding HasRuleStatusFeedback, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RuleStatusFeedback}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeBrandAccent}"/>
                            </Border>

                            <!-- Empty State: No configured rules -->
                            <Border Background="{DynamicResource ThemeCardInnerBackground}" CornerRadius="6" Padding="14,12" Margin="0,0,0,4"
                                    Visibility="{Binding HasActiveRules, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="No filter rules configured. Use recommendations above or expand the advanced builder below."
                                           FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                            </Border>

                        <!-- Active Rules List -->
                        <ItemsControl ItemsSource="{Binding Rules}"
                                      Visibility="{Binding HasActiveRules, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeCardInnerBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Rule Details -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                                    <!-- Active/Paused Status Badge -->
                                                    <Border CornerRadius="4" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#064E3B"/>
                                                                <Setter Property="BorderBrush" Value="#059669"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                        <Setter Property="Background" Value="#1E293B"/>
                                                                        <Setter Property="BorderBrush" Value="#475569"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="● " FontSize="9" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#34D399"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#D1FAE5"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Scope Badge -->
                                                    <Border CornerRadius="4" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📱 " FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ScopeDescription}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeBrandAccent}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TargetField}" FontSize="12" Foreground="{DynamicResource ThemeBrandAccent}"/>
                                                    <TextBlock Text=" " FontSize="12"/>
                                                    <TextBlock Text="{Binding Operator}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                    <TextBlock Text=": '" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}"/>
                                                    <TextBlock Text="{Binding Pattern}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                    <TextBlock Text="'" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Badge -->
                                            <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#475569"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Action}" Value="{x:Static cfg:RuleAction.Drop}">
                                                                <Setter Property="Background" Value="#7F1D1D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="{x:Static cfg:RuleAction.SilentLog}">
                                                                <Setter Property="Background" Value="#1E3A8A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="{x:Static cfg:RuleAction.AlwaysNotify}">
                                                                <Setter Property="Background" Value="#B45309"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ActionDisplayName}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <!-- Enabled Fluent Toggle Switch -->
                                            <CheckBox Grid.Column="2" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                      ToolTip="Toggle rule active state">
                                                <CheckBox.Template>
                                                    <ControlTemplate TargetType="CheckBox">
                                                        <Border x:Name="SwitchBorder" Width="44" Height="24" CornerRadius="12" Background="#475569" Cursor="Hand" Padding="2">
                                                            <Ellipse x:Name="SwitchThumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left">
                                                                <Ellipse.RenderTransform>
                                                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                                                </Ellipse.RenderTransform>
                                                            </Ellipse>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="SwitchBorder" Property="Background" Value="#10B981"/>
                                                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </CheckBox.Template>
                                            </CheckBox>

                                            <!-- Edit Button -->
                                            <Button Grid.Column="3" Content="✏️ Edit" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,8,0"
                                                    ToolTip="Edit this rule in the Advanced Rule Builder" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="4" Content="✕" Width="26" Height="26" Background="Transparent" BorderThickness="0"
                                                    Foreground="#EF4444" FontSize="12" Cursor="Hand" VerticalAlignment="Center" ToolTip="Delete rule"
                                                    Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========================================== -->
                <!-- 3. ADVANCED MANUAL RULE BUILDER SECTION     -->
                <!-- ========================================== -->
                <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Clickable Accordion Header -->
                        <Grid Cursor="Hand">
                            <Grid.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleAdvancedCommand}"/>
                            </Grid.InputBindings>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RuleFormHeaderTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <Border CornerRadius="4" Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" Padding="8,2" Margin="8,0,0,0"
                                            Visibility="{Binding IsEditingRule, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="EDITING" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding RuleFormHeaderSubtitle}"
                                           FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Padding="10,5"
                                    Command="{Binding ToggleAdvancedCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Content" Value="Expand ▼"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                                <Setter Property="Content" Value="Collapse ▲"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Collapsible Builder Form -->
                        <Grid Margin="0,16,0,0" Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row A: Rule Name & Application Scope -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Rule Name -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Rule Name (Optional)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Application Scope -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Application Scope" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableAppFilterOptions}"
                                                  SelectedItem="{Binding SelectedAppFilterOption}"
                                                  DisplayMemberPath="Name"
                                                  Height="34"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row B: Field, Operator, Pattern, Action -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Target Field -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Field" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding NewRuleField}" SelectedValuePath="Tag" Height="34">
                                            <ComboBoxItem Content="Title" Tag="{x:Static cfg:RuleField.Title}" IsSelected="True"/>
                                            <ComboBoxItem Content="Message" Tag="{x:Static cfg:RuleField.Message}"/>
                                            <ComboBoxItem Content="App Name" Tag="{x:Static cfg:RuleField.AppName}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Operator -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Operator" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding NewRuleOperator}" SelectedValuePath="Tag" Height="34">
                                            <ComboBoxItem Content="Contains" Tag="{x:Static cfg:RuleOperator.Contains}" IsSelected="True"/>
                                            <ComboBoxItem Content="Does Not Contain" Tag="{x:Static cfg:RuleOperator.DoesNotContain}"/>
                                            <ComboBoxItem Content="Starts With" Tag="{x:Static cfg:RuleOperator.StartsWith}"/>
                                            <ComboBoxItem Content="Ends With" Tag="{x:Static cfg:RuleOperator.EndsWith}"/>
                                            <ComboBoxItem Content="Exact Match" Tag="{x:Static cfg:RuleOperator.ExactMatch}"/>
                                            <ComboBoxItem Content="Regex Match" Tag="{x:Static cfg:RuleOperator.RegexMatch}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Pattern -->
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="Match Pattern / Keyword / Regex" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding NewRulePattern, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Action -->
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Action" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding NewRuleAction}" SelectedValuePath="Tag" Height="34">
                                            <ComboBoxItem Content="Silent Log" Tag="{x:Static cfg:RuleAction.SilentLog}" IsSelected="True"/>
                                            <ComboBoxItem Content="Drop (Discard)" Tag="{x:Static cfg:RuleAction.Drop}"/>
                                            <ComboBoxItem Content="Always Notify" Tag="{x:Static cfg:RuleAction.AlwaysNotify}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Bottom Row: Case Sensitive & Add/Update Button -->
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Case Sensitive" IsChecked="{Binding NewRuleCaseSensitive}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,16,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Cancel Edit" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                            Visibility="{Binding IsEditingRule, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding CancelEditCommand}"/>
                                    <Button Content="{Binding RuleFormSubmitButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding AddRuleCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- IMPORT RULES PREVIEW & SELECTION MODAL     -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#90000000"
              Visibility="{Binding IsImportModalOpen, Converter={StaticResource BoolToVis}}">
            <!-- Modal Dialog Card -->
            <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}"
                    BorderThickness="1" CornerRadius="10" Width="600" MaxHeight="520" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📥 Import Rules" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="Select the filter rules you want to import into your configuration:"
                                       FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource ThemeTextMuted}" FontSize="13" Cursor="Hand" Command="{Binding CancelImportCommand}"/>
                    </Grid>

                    <!-- Selection Summary & Actions -->
                    <Border Grid.Row="1" Background="{DynamicResource ThemeCardInnerBackground}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ImportSummaryText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Select All" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Command="{Binding SelectAllImportCommand}" CommandParameter="True"/>
                                <Button Content="Deselect All" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Command="{Binding SelectAllImportCommand}" CommandParameter="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable Candidates List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="0,0,0,14">
                        <ItemsControl ItemsSource="{Binding ImportCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeCardInnerBackground}" BorderBrush="{DynamicResource ThemeCardBorder}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                    <!-- Scope badge -->
                                                    <Border CornerRadius="4" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Padding="6,2" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding ScopeDescription}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeBrandAccent}"/>
                                                    </Border>
                                                    <!-- Duplicate warning badge -->
                                                    <Border CornerRadius="4" Background="#78350F" Padding="6,2" Margin="6,0,0,0"
                                                            Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Matches existing" FontSize="11" FontWeight="Bold" Foreground="#FDE68A"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CriteriaSummary}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                            </StackPanel>

                                            <!-- Action badge -->
                                            <Border Grid.Column="2" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#475569"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Action}" Value="{x:Static cfg:RuleAction.Drop}">
                                                                <Setter Property="Background" Value="#7F1D1D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="{x:Static cfg:RuleAction.SilentLog}">
                                                                <Setter Property="Background" Value="#1E3A8A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="{x:Static cfg:RuleAction.AlwaysNotify}">
                                                                <Setter Property="Background" Value="#B45309"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ActionDisplayName}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Actions -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,10,0"
                                Command="{Binding CancelImportCommand}"/>
                        <Button Grid.Column="2" Content="{Binding ImportButtonText}" Style="{StaticResource PrimaryButton}" Padding="16,6"
                                Command="{Binding ConfirmImportCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
