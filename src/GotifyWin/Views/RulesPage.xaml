<UserControl x:Class="GotifyWin.Views.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cfg="clr-namespace:GotifyWin.Models.Config"
             xmlns:conv="clr-namespace:GotifyWin.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Granular Filter Rules" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Intercept and filter specific notifications based on regex, keywords, or sender application."
                       FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Rule Builder Card -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <!-- Target Field -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Field" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource InputComboBox}" SelectedValue="{Binding NewRuleField}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Title" Tag="{x:Static cfg:RuleField.Title}" IsSelected="True"/>
                            <ComboBoxItem Content="Message" Tag="{x:Static cfg:RuleField.Message}"/>
                            <ComboBoxItem Content="App Name" Tag="{x:Static cfg:RuleField.AppName}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Operator -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Operator" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource InputComboBox}" SelectedValue="{Binding NewRuleOperator}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Contains" Tag="{x:Static cfg:RuleOperator.Contains}" IsSelected="True"/>
                            <ComboBoxItem Content="Does Not Contain" Tag="{x:Static cfg:RuleOperator.DoesNotContain}"/>
                            <ComboBoxItem Content="Starts With" Tag="{x:Static cfg:RuleOperator.StartsWith}"/>
                            <ComboBoxItem Content="Ends With" Tag="{x:Static cfg:RuleOperator.EndsWith}"/>
                            <ComboBoxItem Content="Exact Match" Tag="{x:Static cfg:RuleOperator.ExactMatch}"/>
                            <ComboBoxItem Content="Regex Match" Tag="{x:Static cfg:RuleOperator.RegexMatch}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Pattern -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Match Pattern / Keyword / Regex" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding NewRulePattern, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Action -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Action" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource InputComboBox}" SelectedValue="{Binding NewRuleAction}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Drop (Discard)" Tag="{x:Static cfg:RuleAction.Drop}" IsSelected="True"/>
                            <ComboBoxItem Content="Silent Log" Tag="{x:Static cfg:RuleAction.SilentLog}"/>
                            <ComboBoxItem Content="Urgent Alert" Tag="{x:Static cfg:RuleAction.UrgentAlert}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Case Sensitive" IsChecked="{Binding NewRuleCaseSensitive}" FontSize="11" Foreground="#94A3B8" Margin="0,0,16,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="+ Add Rule" Style="{StaticResource PrimaryButton}" Command="{Binding AddRuleCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Rules List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Rule Description -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding TargetField}" FontSize="11" Foreground="#38BDF8"/>
                                        <TextBlock Text=" " FontSize="11"/>
                                        <TextBlock Text="{Binding Operator}" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock Text=": '" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Pattern}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                        <TextBlock Text="'" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Badge -->
                                <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#475569"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="{x:Static cfg:RuleAction.Drop}">
                                                    <Setter Property="Background" Value="#7F1D1D"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="{x:Static cfg:RuleAction.SilentLog}">
                                                    <Setter Property="Background" Value="#78350F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="{x:Static cfg:RuleAction.UrgentAlert}">
                                                    <Setter Property="Background" Value="#1E3A8A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Action}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>

                                <!-- Enabled Toggle -->
                                <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,14,0"
                                          Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}"/>

                                <!-- Delete Button -->
                                <Button Grid.Column="3" Content="✕" Width="26" Height="26" Background="Transparent" BorderThickness="0"
                                        Foreground="#EF4444" FontSize="12" Cursor="Hand" VerticalAlignment="Center"
                                        Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
