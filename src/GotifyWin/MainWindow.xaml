<Window x:Class="GotifyWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GotifyWin.Converters"
        xmlns:views="clr-namespace:GotifyWin.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gotify Client"
        Height="720" Width="960"
        MinHeight="550" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#F8FAFC">
    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="🔔" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gotify" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding ConnectionStatusColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs in Center -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="NavFeedRadio" GroupName="MainNav" Content="Notifications" Style="{StaticResource NavRadioButton}"
                                 Checked="NavFeed_Checked" Margin="0,0,4,0"/>
                    <RadioButton x:Name="NavAppsRadio" GroupName="MainNav" Content="Apps" Style="{StaticResource NavRadioButton}"
                                 Checked="NavApps_Checked" Margin="0,0,4,0"/>
                    <RadioButton x:Name="NavRulesRadio" GroupName="MainNav" Content="Filter Rules" Style="{StaticResource NavRadioButton}"
                                 Checked="NavRules_Checked" Margin="0,0,4,0"/>
                    <RadioButton x:Name="NavSettingsRadio" GroupName="MainNav" Content="Settings" Style="{StaticResource NavRadioButton}"
                                 Checked="NavSettings_Checked"/>
                </StackPanel>

                <!-- Right Quick Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- DND Quick Button with Context Menu -->
                    <Button Content="{Binding DndStatusText}" Style="{StaticResource HeaderActionButton}" Margin="0,0,8,0" Click="DndButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155">
                                <MenuItem Header="Disable DND" Command="{Binding DisableDndCommand}"/>
                                <Separator Background="#334155"/>
                                <MenuItem Header="Snooze 30 minutes" Command="{Binding Snooze30mCommand}"/>
                                <MenuItem Header="Snooze 1 hour" Command="{Binding Snooze1hCommand}"/>
                                <MenuItem Header="Snooze 4 hours" Command="{Binding Snooze4hCommand}"/>
                                <MenuItem Header="Snooze until Tomorrow (8am)" Command="{Binding SnoozeTomorrowCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="🔄" Width="32" Height="32" Style="{StaticResource HeaderActionButton}"
                            ToolTip="Reconnect WebSocket" Command="{Binding ReconnectCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Feed Page -->
            <views:FeedPage x:Name="FeedPageView" DataContext="{Binding Feed}"/>

            <!-- Apps Page -->
            <views:AppsPage x:Name="AppsPageView" DataContext="{Binding Apps}" Visibility="Collapsed"/>

            <!-- Rules Page -->
            <views:RulesPage x:Name="RulesPageView" DataContext="{Binding Rules}" Visibility="Collapsed"/>

            <!-- Settings Page -->
            <views:SettingsPage x:Name="SettingsPageView" DataContext="{Binding Settings}" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
