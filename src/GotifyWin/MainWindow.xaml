<Window x:Class="GotifyWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GotifyWin.Converters"
        xmlns:views="clr-namespace:GotifyWin.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gotify Client"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="720" Width="980"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeTextPrimary}">
    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:DndGlyphConverter x:Key="DndGlyphConverter"/>

        <Style x:Key="DndFlyoutOptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ThemeNavHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ThemeNavChecked}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBrandAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryButtonText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryButtonBorder}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DndHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryButtonText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryButtonBorder}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DndBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DndBorder" Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDndActive}" Value="True">
                                <Setter TargetName="DndBorder" Property="Background" Value="#F59E0B"/>
                                <Setter TargetName="DndBorder" Property="BorderBrush" Value="#D97706"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDndActive}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="DndBorder" Property="Background" Value="#D97706"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryButtonText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryButtonBorder}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReconnectButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
            <Setter Property="ToolTip" Value="Reconnect to Gotify server"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <TextBlock x:Name="IconText" Text="🔄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="IconRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeItemHover}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="ToolTip" Value="Reconnecting to Gotify server..."/>
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinAnimation">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IconRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinAnimation"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Width="44" Height="44" CornerRadius="10" Background="Transparent" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Gotify" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="{Binding AppVersionDisplay, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                       Opacity="0.75"
                                       Margin="6,2,0,0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding ConnectionStatusColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs in Center -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="NavFeedRadio" GroupName="MainNav" Content="Messages" Style="{StaticResource NavRadioButton}"
                                 Checked="NavFeed_Checked" Margin="0,0,4,0"/>
                    <RadioButton x:Name="NavAppsRadio" GroupName="MainNav" Content="Apps" Style="{StaticResource NavRadioButton}"
                                 Checked="NavApps_Checked" Margin="0,0,4,0"/>
                    <RadioButton x:Name="NavRulesRadio" GroupName="MainNav" Content="Filter Rules" Style="{StaticResource NavRadioButton}"
                                 Checked="NavRules_Checked" Margin="0,0,4,0"/>
                    <RadioButton x:Name="NavSettingsRadio" GroupName="MainNav" Content="Settings" Style="{StaticResource NavRadioButton}"
                                 Checked="NavSettings_Checked"/>
                </StackPanel>

                <!-- Right Quick Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Update Available Header Indicator -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Visibility="{Binding Settings.IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                            Command="{Binding NavigateToUpdatesCommand}"
                            ToolTip="A new version of GotifyWin is available. Click to review and install."
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Background="{DynamicResource ThemeBrandAccent}"
                            Foreground="White"
                            BorderBrush="{DynamicResource ThemeBrandAccent}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀 Update " FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Settings.LatestAppVersion}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Modern Fluent DND Flyout -->
                    <Grid Margin="0,0,8,0">
                        <Button x:Name="DndHeaderButton" Style="{StaticResource DndHeaderButtonStyle}" Click="DndButton_Click"
                                MinWidth="104" HorizontalContentAlignment="Center"
                                ToolTip="{Binding DndStatusText}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding IsDndActive, Converter={StaticResource DndGlyphConverter}}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DndButtonLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Popup x:Name="DndFlyout" PlacementTarget="{Binding ElementName=DndHeaderButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource ThemeCardBackground}"
                                    BorderBrush="{DynamicResource ThemeCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14"
                                    Margin="0,6,0,0"
                                    Width="300">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.35" Direction="270"/>
                                </Border.Effect>

                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🌙 Do Not Disturb" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                            <TextBlock Text="Silence incoming notifications &amp; sounds" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Active Banner (shown when DND is ON) -->
                                    <Border Background="{DynamicResource ThemeCardInnerBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                                            Visibility="{Binding IsDndActive, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="🔕 Currently Active" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                                <TextBlock Text="{Binding DndStatusText}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Turn Off" Style="{StaticResource HeaderActionButton}" Padding="8,4" FontSize="11"
                                                    Click="DndDisable_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Manual DND Indefinite -->
                                    <Button Style="{StaticResource DndFlyoutOptionButton}" Click="DndIndefinite_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🔕" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="On until I turn it off" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                <TextBlock Text="Silence indefinitely until turned back on" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Presets Header -->
                                    <TextBlock Text="TIMED SNOOZE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" Margin="4,8,0,6"/>

                                    <Button Style="{StaticResource DndFlyoutOptionButton}" Click="DndSnooze30m_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⏱️" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="30 minutes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                <TextBlock Text="Quick silence for focus or calls" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource DndFlyoutOptionButton}" Click="DndSnooze1h_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⏱️" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="1 hour" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                <TextBlock Text="Standard meeting or deep work" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource DndFlyoutOptionButton}" Click="DndSnooze4h_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⏱️" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="4 hours" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                <TextBlock Text="Half workday silence" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource DndFlyoutOptionButton}" Click="DndSnoozeTomorrow_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🌅" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Until tomorrow (8:00 AM)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                <TextBlock Text="Silence overnight until next morning" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Style="{StaticResource ReconnectButtonStyle}"
                            Command="{Binding ReconnectCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Feed Page -->
            <views:FeedPage x:Name="FeedPageView" DataContext="{Binding Feed}"/>

            <!-- Apps Page -->
            <views:AppsPage x:Name="AppsPageView" DataContext="{Binding Apps}" Visibility="Collapsed"/>

            <!-- Rules Page -->
            <views:RulesPage x:Name="RulesPageView" DataContext="{Binding Rules}" Visibility="Collapsed"/>

            <!-- Settings Page -->
            <views:SettingsPage x:Name="SettingsPageView" DataContext="{Binding Settings}" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
