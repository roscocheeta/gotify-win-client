# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files with Windows CRLF line endings (WPF / MSBuild / Solutions)
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.cs text eol=crlf
*.xaml text eol=crlf
*.manifest text eol=crlf
*.config text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Markdown and documentation
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary files
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.exe binary
*.dll binary
*.zip binary
